generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WatchlistStock {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  sector    String?
  folderId  String?
  folder    WatchlistFolder? @relation(fields: [folderId], references: [id])
  addedAt   DateTime @default(now())
  screenResults ScreeningResult[]
}

model ScreeningResult {
  id          String   @id @default(cuid())
  stockId     String
  stock       WatchlistStock @relation(fields: [stockId], references: [id])
  symbol      String
  date        DateTime @default(now())
  score       Int            // 0-6 confluence score
  setupType   String         // "A+" or "B"
  entryPrice  Float
  stopLoss    Float
  targetPrice Float
  riskReward  Float
  atr         Float
  rsi         Float
  trendAbove  Boolean
  pullbackOk  Boolean
  triggerOk   Boolean
  volumeOk    Boolean
  rsOk        Boolean
  gapOk       Boolean
  regimeSafe  Boolean
  liquid      Boolean
  trending    Boolean
  validVol    Boolean
  qtyA        Int            // Suggested qty for A+ setup
  qtyB        Int            // Suggested qty for B setup
  notes       String?
  createdAt   DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@index([stockId, createdAt])
  @@index([score])
}

model PaperTrade {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  direction     String   @default("LONG")  // LONG / SHORT
  entryDate     DateTime
  entryPrice    Float
  qty           Int
  stopLoss      Float
  targetPrice   Float
  status        String   @default("OPEN")  // OPEN / CLOSED / CANCELLED / AUTO
  exitDate      DateTime?
  exitPrice     Float?
  pnl           Float?   // Alias for netPnl (backward compat)
  pnlPercent    Float?
  // ── Transaction Cost Fields (Phase 2) ──
  grossPnl      Float?   // P&L before any costs (raw entry-exit difference)
  netPnl        Float?   // P&L after ALL costs deducted
  totalCosts    Float?   // Sum of all charges
  brokerageCost Float?   // Flat ₹20/order brokerage
  sttCost       Float?   // Securities Transaction Tax
  slippageCost  Float?   // Market impact / bid-ask slippage
  otherCharges  Float?   // Exchange + GST + SEBI + Stamp duty
  // ──────────────────────────────────────
  screenshot    String?  // path to screenshot
  notes         String?
  tags          String?  // comma-separated tags
  autoTraded    Boolean  @default(false)   // Was this auto-entered?
  exitReason    String?  // TP_HIT / SL_HIT / DEAD_CAPITAL / TRAIL_STOP / MAX_HOLDING
  portfolioId   String?
  portfolio     Portfolio?  @relation(fields: [portfolioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  journal       TradeJournalEntry?

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@index([portfolioId, status])
  @@index([direction, status])
}

model TradeJournalEntry {
  id          String   @id @default(cuid())
  tradeId     String   @unique
  trade       PaperTrade @relation(fields: [tradeId], references: [id])
  mood        String   @default("NEUTRAL")  // CONFIDENT / NEUTRAL / ANXIOUS / FOMO
  marketContext String?
  emotions    String?
  lessonsLearned String?
  rating      Int?     // 1-5 self-rating
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BacktestRun {
  id            String   @id @default(cuid())
  name          String
  symbol        String
  startDate     DateTime
  endDate       DateTime
  initialCapital Float
  finalCapital  Float
  totalTrades   Int
  winTrades     Int
  lossTrades    Int
  winRate       Float
  profitFactor  Float
  maxDrawdown   Float
  avgWin        Float
  avgLoss       Float
  bestTrade     Float
  worstTrade    Float
  sharpeRatio   Float?
  config        String   // JSON string of parameters used
  createdAt     DateTime @default(now())
  trades        BacktestTrade[]
}

model BacktestTrade {
  id            String   @id @default(cuid())
  runId         String
  run           BacktestRun @relation(fields: [runId], references: [id])
  symbol        String
  entryDate     DateTime
  entryPrice    Float
  exitDate      DateTime
  exitPrice     Float
  qty           Int
  pnl           Float
  pnlPercent    Float
  score         Int
  setupType     String
  exitReason    String  // TP_HIT / SL_HIT / DEAD_CAPITAL / TRAIL_STOP
  createdAt     DateTime @default(now())
}

model AppSettings {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  updatedAt    DateTime @updatedAt
}

model CapitalWallet {
  id             String   @id @default(cuid())
  name           String   @default("Main Wallet")
  totalCapital   Float    @default(200000)    // Current total (base + realized P&L)
  initialCapital Float    @default(200000)    // Original allocated capital (never changes from recalc)
  deployed       Float    @default(0)         // Currently invested
  available      Float    @default(200000)    // Available for new trades
  realizedPnl    Float    @default(0)         // Total realized NET P&L (after costs)
  unrealizedPnl  Float    @default(0)         // Current open positions P&L
  peakCapital    Float    @default(0)         // Highest NAV reached — for drawdown HWM tracking
  totalCostsPaid Float    @default(0)         // Cumulative costs paid (STT + brokerage + slippage + etc.)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([id])  // Ensure quick singleton lookup
}

model DailySnapshot {
  id             String   @id @default(cuid())
  date           String   @unique             // YYYY-MM-DD
  nav            Float                       // Net Asset Value = totalCapital + unrealizedPnl
  realizedPnl    Float    @default(0)
  unrealizedPnl  Float    @default(0)
  totalCapital   Float    @default(0)
  deployed       Float    @default(0)
  openPositions  Int      @default(0)
  dailyPnl       Float    @default(0)         // P&L change from previous snapshot
  dailyReturn    Float    @default(0)         // % return from previous snapshot
  createdAt      DateTime @default(now())
}

model AutoTradeLog {
  id            String   @id @default(cuid())
  action        String   // AUTO_ENTRY / AUTO_EXIT_TP / AUTO_EXIT_SL / AUTO_EXIT_MAX_HOLDING / AUTO_EXIT_TRAIL
  symbol        String
  tradeId       String?
  signal        String   // JSON of the signal data
  executed      Boolean  @default(false)
  reason        String?
  createdAt     DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@index([action])
}

model UniverseScan {
  id            String   @id @default(cuid())
  scanType      String   @default("L1")       // L1 / FULL
  totalScanned  Int
  l1Passed      Int
  l2Signals     Int
  dataSource    String   @default("yahoo")    // yahoo / error
  duration      Float    @default(0)         // seconds
  results       String   // JSON of results
  createdAt     DateTime @default(now())
}

model Portfolio {
  id            String   @id @default(cuid())
  name          String                        // e.g. "Aggressive", "Conservative"
  description   String?
  isDefault     Boolean @default(false)
  totalCapital  Float   @default(200000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trades        PaperTrade[]
  sipPlans      SIPPlan[]
}

model PriceAlert {
  id            String   @id @default(cuid())
  symbol        String
  condition      String   // ABOVE / BELOW / CROSSES_ABOVE / CROSSES_BELOW
  targetPrice   Float
  notes         String?
  active        Boolean @default(true)
  triggered     Boolean @default(false)
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([symbol, active])
  @@index([triggered])
}

model DividendRecord {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  exDate        DateTime
  dividendPerShare Float
  totalAmount   Float    // dividendPerShare * qty held
  qty           Int?
  recordDate    DateTime?
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

model SIPPlan {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  amount        Float    // fixed amount per installment
  frequency     String   @default("MONTHLY")  // WEEKLY / MONTHLY / QUARTERLY
  nextDate      DateTime
  totalInvested Float    @default(0)
  totalQty      Int      @default(0)
  installmentsCompleted Int @default(0)
  active        Boolean  @default(true)
  portfolioId   String?
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WatchlistFolder {
  id            String   @id @default(cuid())
  name          String
  color         String   @default("#6366f1")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  stocks        WatchlistStock[]
}

model OptionTrade {
  id            String   @id @default(cuid())
  symbol        String
  underlyingPrice Float
  optionType    String
  action        String
  strikePrice   Float
  expiryDate    String
  lotSize       Int
  qty           Int
  entryPremium  Float
  currentPremium Float?
  stopLoss      Float?
  takeProfit    Float?
  status        String   @default("OPEN")
  entryDate     DateTime @default(now())
  exitDate      DateTime?
  exitPremium   Float?
  pnl           Float?
  pnlPercent    Float?
  marginUsed    Float?
  strategyId    String?
  strategy      OptionStrategy? @relation(fields: [strategyId], references: [id])
  entryDelta    Float?
  entryGamma    Float?
  entryTheta    Float?
  entryVega     Float?
  entryIV       Float?
  slReasoning   String?
  tpReasoning   String?
  exitReason    String?
  notes         String?
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@index([expiryDate])
  @@index([optionType, action, status])
}

model OptionStrategy {
  id            String   @id @default(cuid())
  name          String
  symbol        String
  underlyingPrice Float
  status        String   @default("OPEN")
  totalMargin   Float
  totalPnl      Float   @default(0)
  legs          String
  entryDate     DateTime @default(now())
  exitDate      DateTime?
  expiryDate    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trades        OptionTrade[]

  @@index([symbol, status])
  @@index([createdAt])
}