generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WatchlistStock {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  sector    String?
  folderId  String?
  folder    WatchlistFolder? @relation(fields: [folderId], references: [id])
  addedAt   DateTime @default(now())
  screenResults ScreeningResult[]
}

model ScreeningResult {
  id          String   @id @default(cuid())
  stockId     String
  stock       WatchlistStock @relation(fields: [stockId], references: [id])
  symbol      String
  date        DateTime @default(now())
  score       Int            // 0-6 confluence score
  setupType   String         // "A+" or "B"
  entryPrice  Float
  stopLoss    Float
  targetPrice Float
  riskReward  Float
  atr         Float
  rsi         Float
  trendAbove  Boolean
  pullbackOk  Boolean
  triggerOk   Boolean
  volumeOk    Boolean
  rsOk        Boolean
  gapOk       Boolean
  regimeSafe  Boolean
  liquid      Boolean
  trending    Boolean
  validVol    Boolean
  qtyA        Int            // Suggested qty for A+ setup
  qtyB        Int            // Suggested qty for B setup
  notes       String?
  createdAt   DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@index([stockId, createdAt])
  @@index([score])
}

model PaperTrade {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  direction     String   @default("LONG")  // LONG / SHORT
  entryDate     DateTime
  entryPrice    Float
  qty           Int
  stopLoss      Float
  targetPrice   Float
  status        String   @default("OPEN")  // OPEN / CLOSED / CANCELLED / AUTO
  exitDate      DateTime?
  exitPrice     Float?
  pnl           Float?   // Alias for netPnl (backward compat)
  pnlPercent    Float?
  // ── Transaction Cost Fields (Phase 2) ──
  grossPnl      Float?   // P&L before any costs (raw entry-exit difference)
  netPnl        Float?   // P&L after ALL costs deducted
  totalCosts    Float?   // Sum of all charges
  brokerageCost Float?   // Flat ₹20/order brokerage
  sttCost       Float?   // Securities Transaction Tax
  slippageCost  Float?   // Market impact / bid-ask slippage
  otherCharges  Float?   // Exchange + GST + SEBI + Stamp duty
  // ──────────────────────────────────────
  screenshot    String?  // path to screenshot
  notes         String?
  tags          String?  // comma-separated tags
  autoTraded    Boolean  @default(false)   // Was this auto-entered?
  exitReason    String?  // TP_HIT / SL_HIT / DEAD_CAPITAL / TRAIL_STOP / MAX_HOLDING
  portfolioId   String?
  portfolio     Portfolio?  @relation(fields: [portfolioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  journal       TradeJournalEntry?

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@index([portfolioId, status])
  @@index([direction, status])
}

model TradeJournalEntry {
  id          String   @id @default(cuid())
  tradeId     String   @unique
  trade       PaperTrade @relation(fields: [tradeId], references: [id])
  mood        String   @default("NEUTRAL")  // CONFIDENT / NEUTRAL / ANXIOUS / FOMO
  marketContext String?
  emotions    String?
  lessonsLearned String?
  rating      Int?     // 1-5 self-rating
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BacktestRun {
  id            String   @id @default(cuid())
  name          String
  symbol        String
  startDate     DateTime
  endDate       DateTime
  initialCapital Float
  finalCapital  Float
  totalTrades   Int
  winTrades     Int
  lossTrades    Int
  winRate       Float
  profitFactor  Float
  maxDrawdown   Float
  avgWin        Float
  avgLoss       Float
  bestTrade     Float
  worstTrade    Float
  sharpeRatio   Float?
  config        String   // JSON string of parameters used
  createdAt     DateTime @default(now())
  trades        BacktestTrade[]
}

model BacktestTrade {
  id            String   @id @default(cuid())
  runId         String
  run           BacktestRun @relation(fields: [runId], references: [id])
  symbol        String
  entryDate     DateTime
  entryPrice    Float
  exitDate      DateTime
  exitPrice     Float
  qty           Int
  pnl           Float
  pnlPercent    Float
  score         Int
  setupType     String
  exitReason    String  // TP_HIT / SL_HIT / DEAD_CAPITAL / TRAIL_STOP
  createdAt     DateTime @default(now())
}

model AppSettings {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  updatedAt    DateTime @updatedAt
}

model CapitalWallet {
  id             String   @id @default(cuid())
  name           String   @default("Main Wallet")
  totalCapital   Float    @default(200000)    // Current total (base + realized P&L)
  initialCapital Float    @default(200000)    // Original allocated capital (never changes from recalc)
  deployed       Float    @default(0)         // Currently invested
  available      Float    @default(200000)    // Available for new trades
  realizedPnl    Float    @default(0)         // Total realized NET P&L (after costs)
  unrealizedPnl  Float    @default(0)         // Current open positions P&L
  peakCapital    Float    @default(0)         // Highest NAV reached — for drawdown HWM tracking
  totalCostsPaid Float    @default(0)         // Cumulative costs paid (STT + brokerage + slippage + etc.)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([id])  // Ensure quick singleton lookup
}

model DailySnapshot {
  id             String   @id @default(cuid())
  date           String   @unique             // YYYY-MM-DD
  nav            Float                       // Net Asset Value = totalCapital + unrealizedPnl
  realizedPnl    Float    @default(0)
  unrealizedPnl  Float    @default(0)
  totalCapital   Float    @default(0)
  deployed       Float    @default(0)
  openPositions  Int      @default(0)
  dailyPnl       Float    @default(0)         // P&L change from previous snapshot
  dailyReturn    Float    @default(0)         // % return from previous snapshot
  createdAt      DateTime @default(now())
}

model AutoTradeLog {
  id            String   @id @default(cuid())
  action        String   // AUTO_ENTRY / AUTO_EXIT_TP / AUTO_EXIT_SL / AUTO_EXIT_MAX_HOLDING / AUTO_EXIT_TRAIL
  symbol        String
  tradeId       String?
  signal        String   // JSON of the signal data
  executed      Boolean  @default(false)
  reason        String?
  createdAt     DateTime @default(now())

  @@index([symbol])
  @@index([createdAt])
  @@index([action])
}

model UniverseScan {
  id            String   @id @default(cuid())
  scanType      String   @default("L1")       // L1 / FULL
  totalScanned  Int
  l1Passed      Int
  l2Signals     Int
  dataSource    String   @default("yahoo")    // yahoo / error
  duration      Float    @default(0)         // seconds
  results       String   // JSON of results
  createdAt     DateTime @default(now())
}

model Portfolio {
  id            String   @id @default(cuid())
  name          String                        // e.g. "Aggressive", "Conservative"
  description   String?
  isDefault     Boolean @default(false)
  totalCapital  Float   @default(200000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trades        PaperTrade[]
  sipPlans      SIPPlan[]
}

model PriceAlert {
  id            String   @id @default(cuid())
  symbol        String
  condition      String   // ABOVE / BELOW / CROSSES_ABOVE / CROSSES_BELOW
  targetPrice   Float
  notes         String?
  active        Boolean @default(true)
  triggered     Boolean @default(false)
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([symbol, active])
  @@index([triggered])
}

model DividendRecord {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  exDate        DateTime
  dividendPerShare Float
  totalAmount   Float    // dividendPerShare * qty held
  qty           Int?
  recordDate    DateTime?
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

model SIPPlan {
  id            String   @id @default(cuid())
  symbol        String
  stockName     String?
  amount        Float    // fixed amount per installment
  frequency     String   @default("MONTHLY")  // WEEKLY / MONTHLY / QUARTERLY
  nextDate      DateTime
  totalInvested Float    @default(0)
  totalQty      Int      @default(0)
  installmentsCompleted Int @default(0)
  active        Boolean  @default(true)
  portfolioId   String?
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WatchlistFolder {
  id            String   @id @default(cuid())
  name          String
  color         String   @default("#6366f1")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  stocks        WatchlistStock[]
}

model OptionTrade {
  id            String   @id @default(cuid())
  symbol        String
  underlyingPrice Float
  optionType    String
  action        String
  strikePrice   Float
  expiryDate    String
  lotSize       Int
  qty           Int
  entryPremium  Float
  currentPremium Float?
  stopLoss      Float?
  takeProfit    Float?
  status        String   @default("OPEN")
  entryDate     DateTime @default(now())
  exitDate      DateTime?
  exitPremium   Float?
  pnl           Float?
  pnlPercent    Float?
  marginUsed    Float?
  strategyId    String?
  strategy      OptionStrategy? @relation(fields: [strategyId], references: [id])
  entryDelta    Float?
  entryGamma    Float?
  entryTheta    Float?
  entryVega     Float?
  entryIV       Float?
  slReasoning   String?
  tpReasoning   String?
  exitReason    String?
  notes         String?
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([status])
  @@index([createdAt])
  @@index([expiryDate])
  @@index([optionType, action, status])
}

// Real weekly Relative-Strength ranking — replaces the previously static/
// hardcoded "Top 7 Ranked Symbols" list. Computed every Monday (and once on
// first boot) from real historical price data vs. the Nifty 50 benchmark.
model WeeklyRanking {
  id          String   @id @default(cuid())
  cycleDate   String                          // YYYY-MM-DD — the Monday this ranking was computed for
  symbol      String
  name        String
  sector      String?
  rank        Int                             // 1 = strongest relative strength
  rsScore     Float                           // blended real RS score vs Nifty 50 (higher = stronger)
  weightPct   Float                           // rank-based normalized capital weight (sums to ~1.0 across the Top 7)
  perf1W      Float                           // real trailing 1-week % return
  perf1M      Float                           // real trailing 1-month % return
  isTop7      Boolean  @default(false)        // true = active Top-7 trading slot; false = vacant-slot candidate
  isActive    Boolean  @default(true)         // false once superseded by a newer cycle
  createdAt   DateTime @default(now())

  @@index([cycleDate])
  @@index([isActive, isTop7])
  @@index([symbol])
}

// Recorder + validator pattern (Layer 3 statistical intelligence) — logs
// every live options signal's full factor breakdown at signal time, then
// once the linked trade resolves, stamps the real outcome so a genuine
// per-factor win-rate attribution can be computed from real forward results
// instead of a backtest (can't include OI/VIX/chain data — no historical
// option-chain dataset exists) or an unfed genetic algorithm.
model SignalRecord {
  id          String    @id @default(cuid())
  symbol      String
  direction   String                          // CE / PE
  score       Int
  confidence  Int
  reasons     String                          // JSON array of the raw human-readable reason strings at signal time
  checksJson  String?                         // JSON object of the keyed per-factor booleans at signal time (trendAbove/pullbackOk/etc for equity, decisionVote-style for options) — was computed live but discarded before 2026-07-28; added so postmortem analysis can attribute outcomes to specific factor combinations instead of parsing normalized reason-text buckets
  executed    Boolean   @default(false)       // did this signal actually become a paper trade?
  tradeId     String?   @unique               // linked PaperTrade.id once/if executed
  resolved    Boolean   @default(false)       // has the linked trade closed?
  win         Boolean?
  netPnl      Float?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([symbol])
  @@index([resolved])
  @@index([tradeId])
}

// Shadow forward-test for options — records EVERY signal the live scanner
// (options-scanner.ts) produces above the sniper score/confidence bar,
// whitelisted or not, and tracks a simulated SL/TP outcome using real live
// premiums. No real capital ever touches these rows. Built 2026-07-28
// because the options backtest (screening-engine.ts) is a SEPARATE
// implementation that had drifted out of sync with the live scanner as of
// 2026-07-27 — this is real forward evidence instead of a stale/divergent
// backtest, for deciding whether to expand past the current TOP-10.
model ShadowOptionSignal {
  id           String    @id @default(cuid())
  symbol       String                          // underlying, e.g. RELIANCE
  direction    String                          // CE / PE
  strike       Float
  expiry       String
  score        Int
  confidence   Int
  entryPremium Float
  stopLoss     Float
  targetPrice  Float
  inTop10      Boolean   @default(false)       // was this symbol part of the real-traded TOP-10/index set at signal time?
  notionalQty  Int       @default(0)           // lots x lotSize, sized the same way a real entry would be (risk% of capital / risk-per-lot)
  notionalCapital Float  @default(0)           // entryPremium x notionalQty — capital that WOULD have been deployed
  status       String    @default("OPEN")      // OPEN / CLOSED
  exitPremium  Float?
  exitReason   String?
  pnlPercent   Float?
  netPnl       Float?                          // (exitPremium - entryPremium) x notionalQty
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  @@index([symbol])
  @@index([status])
}

model OptionStrategy {
  id            String   @id @default(cuid())
  name          String
  symbol        String
  underlyingPrice Float
  status        String   @default("OPEN")
  totalMargin   Float
  totalPnl      Float   @default(0)
  legs          String
  entryDate     DateTime @default(now())
  exitDate      DateTime?
  expiryDate    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trades        OptionTrade[]

  @@index([symbol, status])
  @@index([createdAt])
}